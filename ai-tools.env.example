# Template for ~/git/ai-tools.env (Scope A hostnames / default usernames).
# Copy and fill with real values, or install the internal file:
#   curl -fsSL -o ~/git/ai-tools.env \
#     https://gitlab.cee.redhat.com/jvavra/jvavra-test-tools/-/raw/master/ai-tools.env
#   # or: cp ~/git/jvavra-test-tools/ai-tools.env ~/git/ai-tools.env
# Optional: export AI_TOOLS_ENV=/path/to/ai-tools.env
# Shell: set -a && source ~/git/ai-tools.env && set +a
# CLIs also auto-load ~/git/ai-tools.env when present.

# GitLab CEE
GITLAB_HOST=gitlab.example.invalid
GIT_STATS_GITLAB_HOST=gitlab.example.invalid
IDMCI_GITREPO=https://gitlab.example.invalid/example-group/idm-ci.git

# Jenkins CSB
JENKINS_URL=https://jenkins.example.invalid

# Brewroot RPM mirror
BREWROOT_PACKAGES=https://brewroot.example.invalid/brewroot/packages

# OpenShift (local IdM Jenkins / DnO hub)
OC_LOGIN_SSO_API_URL=https://api.openshift.example.invalid:6443
OC_LOGIN_SSO_PROJECT=example-jenkins-project

# Corp proxy (local Jenkins agent image builds)
HTTP_PROXY=http://proxy.example.invalid:3128
HTTPS_PROXY=http://proxy.example.invalid:3128
NO_PROXY=localhost,127.0.0.1,10.0.0.0/8,.example.invalid

# Internal container registry
INTERNAL_REGISTRY=registry.example.invalid
INTERNAL_REGISTRY_USER=registry-bot+example_sa
INTERNAL_REGISTRY_NAMESPACE=example-ns
INTERNAL_REGISTRY_AGENT_IMAGE=registry.example.invalid/example-ns/idm-ci-jenkins

# IdM-CI artifacts + docs
IDM_ARTIFACTS_URL=https://artifacts.example.invalid
DOCS_IDMCI_URL=https://docs-idmci.example.invalid

# Polarion
POLARION_URL=https://polarion.example.invalid

# RHEL compose / nightly mirror (triage, compose URLs)
RHEL_COMPOSE_MIRROR=http://compose.example.invalid
